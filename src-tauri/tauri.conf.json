{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "freedock",
  "version": "0.1.1",
  "identifier": "io.github.shawnzhu02.freedock",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "dock",
        "title": "freedock",
        "url": "index.html",
        "width": 900,
        "height": 56,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "The free, infinitely customizable dock for Windows",
    "publisher": "freedock contributors",
    "copyright": "Copyright (c) 2026 shawnzhu02 and freedock contributors. MIT License."
  }
}
